class Product {
    String productName;
    double price;
    int quantity;

    // 1. Default Constructor (No arguments)[span_0](start_span)[span_0](end_span)
    Product() {
        productName = "Unknown";
        price = 0.0;
        quantity = 0;
    }

    // 2. Constructor with product name only[span_1](start_span)[span_1](end_span)
    Product(String productName) {
        this.productName = productName;
        this.price = 0.0;
        this.quantity = 0;
    }

    // 3. Constructor with product name and price[span_2](start_span)[span_2](end_span)
    Product(String productName, double price) {
        this.productName = productName;
        this.price = price;
        this.quantity = 0;
    }

    // 4. Constructor with all three fields[span_3](start_span)[span_3](end_span)
    Product(String productName, double price, int quantity) {
        this.productName = productName;
        this.price = price;
        this.quantity = quantity;
    }

    // Method to calculate total cost[span_4](start_span)[span_4](end_span)
    double calculateTotalCost() {
        return price * quantity;
    }

    // Method to display object details[span_5](start_span)[span_5](end_span)
    void displayDetails() {
        System.out.println("Product Name: " + productName);
        System.out.println("Price: ₹" + price);
        System.out.println("Quantity: " + quantity);
        System.out.println("Total Cost: ₹" + calculateTotalCost());
        System.out.println("-----------------------------------");
    }
}

public class Main {
    public static void main(String[] args) {
        // Creating objects using different constructors[span_6](start_span)[span_6](end_span)
        Product p1 = new Product();                               // No arguments
        Product p2 = new Product("Laptop");                       // Name only
        Product p3 = new Product("Smartphone", 25000.0);          // Name and price
        Product p4 = new Product("Headphones", 1500.0, 2);        // All three fields

        // Displaying output for every constructor variation[span_7](start_span)[span_7](end_span)
        System.out.println("--- Constructor Variation 1 (No Arguments) ---");
        p1.displayDetails();

        System.out.println("--- Constructor Variation 2 (Name Only) ---");
        p2.displayDetails();

        System.out.println("--- Constructor Variation 3 (Name and Price) ---");
        p3.displayDetails();

        System.out.println("--- Constructor Variation 4 (All Three Fields) ---");
        p4.displayDetails();
    }
}

